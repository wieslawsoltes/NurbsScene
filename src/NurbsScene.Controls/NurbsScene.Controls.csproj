<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(NurbsSceneDesktopOnly)'=='true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Library</OutputType><UnoSingleProject>true</UnoSingleProject><IsPackable>true</IsPackable><GenerateLibraryLayout>true</GenerateLibraryLayout>
    <UnoFeatures>WebGpu</UnoFeatures><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Reusable Uno CAD viewports, visual graph canvas, command console, inspectors and workspace controls.</Description>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Drawing/Fonts/*.ttf" />
    <EmbeddedResource Include="Drawing/Fonts/LICENSE-DejaVu.txt" />
    <None Update="Drawing/Fonts/LICENSE-DejaVu.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Pack="true" PackagePath="licenses/DejaVu.txt" />
    <ProjectReference Include="../NurbsScene.Workbench/NurbsScene.Workbench.csproj" />
    <ProjectReference Include="../NurbsScene.Presentation/NurbsScene.Presentation.csproj" />
  </ItemGroup>
</Project>
