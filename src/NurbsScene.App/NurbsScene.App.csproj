<Project Sdk="Uno.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-desktop;net10.0-browserwasm</TargetFrameworks>
    <TargetFrameworks Condition="'$(NurbsSceneDesktopOnly)'=='true'">net10.0-desktop</TargetFrameworks>
    <OutputType>Exe</OutputType><UnoSingleProject>true</UnoSingleProject><IsPackable>false</IsPackable>
    <ApplicationTitle>NurbsScene</ApplicationTitle><ApplicationId>org.nurbsscene.studio</ApplicationId>
    <ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion><ApplicationVersion>1</ApplicationVersion><ApplicationPublisher>NurbsScene contributors</ApplicationPublisher>
    <UnoFeatures>WebGpu</UnoFeatures><AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <WasmShellWebAppBasePath>./</WasmShellWebAppBasePath>
    <WasmShellILLinkerEnabled>false</WasmShellILLinkerEnabled><PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../NurbsScene.Controls/NurbsScene.Controls.csproj" />
  </ItemGroup>
  <PropertyGroup Condition="'$(NurbsSceneQualification)' == 'true' and '$(TargetFramework)' == 'net10.0-browserwasm'">
    <DefineConstants>$(DefineConstants);NURBSSCENE_QUALIFICATION</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NurbsSceneDesktopQualification)' == 'true' and '$(TargetFramework)' == 'net10.0-desktop'">
    <DefineConstants>$(DefineConstants);NURBSSCENE_DESKTOP_QUALIFICATION</DefineConstants>
  </PropertyGroup>
</Project>
